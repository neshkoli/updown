{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UpDown",
  "version": "2.1.1",
  "identifier": "com.noam.updown",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UpDown",
        "width": 1000,
        "height": 700,
        "minWidth": 400,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost; frame-src 'self' asset: http://ipc.localhost http://asset.localhost https://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME", "$HOME/*", "$HOME/**", "/Volumes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
